# Managed by patrabahok — do not edit by hand, changes will be overwritten on re-install.
protocols = imap lmtp

mail_location = maildir:~/Maildir
mail_plugins = $mail_plugins quota

mail_uid = vmail
mail_gid = vmail
first_valid_uid = 5000
last_valid_uid = 5000

passdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}

userdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}

disable_plaintext_auth = yes
auth_mechanisms = plain login

ssl = required
ssl_cert = <{{TLS_CERT}}
ssl_key = <{{TLS_KEY}}
ssl_min_protocol = TLSv1.2
ssl_cipher_list = ECDHE+AESGCM:ECDHE+CHACHA20:DHE+AESGCM:!aNULL:!MD5:!DSS
ssl_prefer_server_ciphers = no

service imap-login {
  inet_listener imap {
    port = 0
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
}

service pop3-login {
  inet_listener pop3 {
    port = 0
  }
  inet_listener pop3s {
    port = 0
  }
}

service lmtp {
  unix_listener /var/spool/postfix/private/dovecot-lmtp {
    mode = 0600
    user = postfix
    group = postfix
  }
}

service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
  unix_listener auth-userdb {
    mode = 0600
    user = vmail
  }
}

protocol lmtp {
  mail_plugins = $mail_plugins sieve
}

protocol lda {
  mail_plugins = $mail_plugins sieve
}

protocol imap {
  mail_plugins = $mail_plugins imap_quota
}

plugin {
  sieve = file:~/sieve;active=~/.dovecot.sieve
  # Applied to every mailbox before its own personal sieve rules — files Rspamd-flagged
  # spam into Junk automatically. See templates/dovecot/sieve/spam-to-junk.sieve.
  sieve_before = /etc/dovecot/sieve/spam-to-junk.sieve
  # maildir backend: fast quota tracking via a maintained maildirsize file rather than
  # rescanning the whole mailbox on every check — the standard choice for Maildir
  # storage. The actual per-mailbox LIMIT comes from userdb's quota_rule extra field
  # (dovecot-sql.conf.ext's user_query, reading virtual_users.quota_bytes), not from a
  # static value here — every mailbox previously shared one hardcoded 1G limit
  # regardless of what was actually stored in the database for it.
  quota = maildir:User quota
}
