<?php
// Rendered by lib/phases/90-webmail.sh: lets users change their own mailbox password
// from Roundcube's Settings. It connects as a dedicated MariaDB user that can only read
// virtual_users' email/enabled columns and update its password column.

$config['password_driver'] = 'sql';
$config['password_db_dsn'] = 'mysql://roundcube_pw:{{PW_DB_PASSWORD}}@localhost/{{MAIL_DB_NAME}}';
// Same scheme Dovecot verifies against (default_pass_scheme in dovecot-sql.conf.ext).
$config['password_algorithm'] = 'sha512-crypt';
$config['password_algorithm_prefix'] = '{SHA512-CRYPT}';
$config['password_query'] = 'UPDATE virtual_users SET password = %P WHERE email = %u AND enabled = 1';
$config['password_confirm_current'] = true;
$config['password_minimum_length'] = 8;
