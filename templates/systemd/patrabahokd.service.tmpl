[Unit]
Description=patrabahok local management API, admin web dashboard, and public HTTPS (API, webmail, MTA-STS)
After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=simple
ExecStart=/usr/local/bin/patrabahokd -web-addr :8443 -web-cert {{TLS_CERT}} -web-key {{TLS_KEY}} -https-addr :443 -webmail-upstream={{WEBMAIL_UPSTREAM}} -policy-addr 127.0.0.1:10040
Restart=on-failure
RestartSec=2
RuntimeDirectory=patrabahok
RuntimeDirectoryMode=0755
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# /var/spool/postfix: mail queue actions (postsuper); /etc/fail2ban/jail.d: the dashboard's
# never-ban allowlist. Both are written only through fixed, validated commands (internal/ops).
ReadWritePaths=/var/mail/vhosts /var/lib/rspamd/dkim -/var/lib/patrabahok /etc/patrabahok -/var/spool/postfix -/etc/fail2ban/jail.d

[Install]
WantedBy=multi-user.target
