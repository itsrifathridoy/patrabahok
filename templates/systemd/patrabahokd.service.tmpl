[Unit]
Description=patrabahok local management API and admin web dashboard
After=network.target mariadb.service
Requires=mariadb.service

[Service]
Type=simple
ExecStart=/usr/local/bin/patrabahokd -web-addr :8443 -web-cert {{TLS_CERT}} -web-key {{TLS_KEY}}
Restart=on-failure
RestartSec=2
RuntimeDirectory=patrabahok
RuntimeDirectoryMode=0755
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/mail/vhosts

[Install]
WantedBy=multi-user.target
